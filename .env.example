# PizzaHub Server Environment Variables
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=your_mongodb_connection_string
DB_NAME=pizzahub

# Stripe Secret Key (for Vendor Subscriptions)
# Test key starts with sk_test_
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Secret (obtained from Stripe CLI or Stripe Dashboard)
# Starts with whsec_
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ImgBB API Key (for server-side menu item image uploads)
IMGBB_API_KEY=your_imgbb_api_key
